KETTLE_IP=###.###.###.###
KETTLE_TOKEN=#################
BOT_TOKEN=#################
ADMIN_ID=None # айди пользователей (через запятую) которым отвечает тг бот. None - отвечает всем
API_BASE_URL=http://127.0.0.1:8000 #для примера
KETTLE_USERNAME=########
KETTLE_PASSWORD=#####################
JWT_SECRET=change
PROXY_URL=http://127.0.0.1:10809 # прокси для тг-бота (например xray: http://127.0.0.1:10809). None - без прокси.
QUIET_MODE_START=23:00:00 # начало тихого режима (ЧЧ:ММ:СС)
QUIET_MODE_END=11:00:00 # конец тихого режима (ЧЧ:ММ:СС)
QUIET_MODE_TIMEZONE=Europe/Moscow
REDIS_URL= #если без Docker - redis://localhost:6379/0 (Docker сам все подставит)
YANDEX_CLIENT_ID= # client_id OAuth-приложения из консоли Яндекс Диалогов (для валидации /auth/yandex/authorize)
